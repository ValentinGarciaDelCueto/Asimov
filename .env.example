# ============================================================
#  .env.example — Copiá este archivo como ".env" y completá
#  tus valores reales. El archivo .env NUNCA se sube a GitHub.
# ============================================================

# ------ PROVEEDOR DE IA ------
# "groq" (gratis, default) o "anthropic" (pago)
PROVIDER=groq

# ------ GROQ (si PROVIDER=groq) ------
# Obtené tu key en: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# ------ ANTHROPIC (si PROVIDER=anthropic) ------
# Obtené tu key en: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ------ CAMPUS UNO ------
CAMPUS_USER=tu_usuario_del_campus
CAMPUS_PASS=tu_contraseña_del_campus

# ------ NOTION ------
# Token: https://www.notion.so/my-integrations → Internal Integration
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxx
# ID de tu base de datos (32 chars en la URL entre la última / y el ?)
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------ RUTAS ------
# Carpeta donde están tus PDFs y DOCX organizados por materia
DOCUMENTS_ROOT=C:\Users\TuNombre\Documentos\Universidad
