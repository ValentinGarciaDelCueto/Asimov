# ============================================================
#  .env.example — Copiá como ".env" y completá tus valores.
#  El archivo .env NUNCA se sube a GitHub.
# ============================================================

# ------ PROVEEDOR DE IA ------
# "groq" (gratis, default) o "anthropic" (pago)
PROVIDER=groq

# ------ GROQ (si PROVIDER=groq) ------
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_CHUNK_SIZE=2000
GROQ_DAILY_LIMIT=100000

# ------ ANTHROPIC (si PROVIDER=anthropic) ------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MODEL=claude-haiku-4-5-20251001
MAX_TOKENS_RESPONSE=4000
CHUNK_SIZE=3000

# ------ CAMPUS UNO ------
CAMPUS_USER=tu_dni
CAMPUS_PASS=tu_contraseña
CAMPUS_HEADLESS=true

# ------ GOOGLE DRIVE ------
# Setup (una vez):
# 1. GCP Console → Habilitar "Google Drive API"
# 2. Credenciales → Crear → OAuth client ID → Desktop app → Descargar JSON
# 3. Renombrar el archivo a "credentials.json" y ponerlo en la raíz del proyecto
# 4. Primer run abre el browser para que apruebes → cachea token.json

DRIVE_CREDENTIALS_FILE=credentials.json
DRIVE_TOKEN_FILE=token.json
# ID de carpeta raíz en Drive (vacío = auto-crear "Resumenes UNO")
DRIVE_PARENT_FOLDER_ID=

# ------ RUTAS ------
RAW_ROOT=./data/raw
PROCESSED_ROOT=./data/processed

# ------ PROMPT DE RESUMEN ------
SUMMARY_PROMPT_TEMPLATE=Eres un asistente académico experto y utilizas la tecnica de feynman de forma perfecta para hacer los resumens. Analiza el siguiente contenido universitario y genera un resumen estructurado.

CONTENIDO:
{text}

Genera un resumen con esta estructura exacta en Markdown:

## Tema Central
[Una oración que capture la idea principal]

##Conceptos Clave
- [Concepto 1]: [Definición breve]
- [Concepto 2]: [Definición breve]
- [Concepto 3]: [Definición breve]
(máximo 8 conceptos)

## Desarrollo
[3 párrafo explicando el contenido de forma clara y ordenada]

##Conexiones
[Menciona brevemente cómo este tema se relaciona con otros conceptos o áreas]

##Preguntas para el Examen
1. [Pregunta probable 1]
2. [Pregunta probable 2]
3. [Pregunta probable 3]

Sé conciso pero completo. Usa lenguaje académico claro. Recomienda tambien tecnicas de estudio como un pequeño bonus para el estudiante.

Si el archivo analizado es un parcial quiero que le recomiendes que contenidos son necesarios para completar este parcial   .
